{
  "expo": {
    "name": "Spoof Detection",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app needs camera access for identity verification and to scan payment details from slips or labels."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "This app needs camera access for identity verification and to scan payment details from slips or labels.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withStripIosPushEntitlement"
    ],
    "slug": "spoof-detection-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access for identity verification and to scan payment details from slips or labels.",
        "NSFaceIDUsageDescription": "This app uses Face ID to authorize secure device-key signatures.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access to select ID photos and upload payment slips for scanning.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.blackgram.spoofdetectionmobile"
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.blackgram.spoofdetectionmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e39f83bd-c5f5-4d82-b626-988c440cd627"
      }
    }
  }
}
